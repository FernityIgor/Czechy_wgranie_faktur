# ===========================================
# KONFIGURACJA WDROŻENIA NA SERWER TEST
# ===========================================
# Skopiuj ten plik jako deploy.env i uzupełnij dane:
#   cp deploy.env.example deploy.env

# Adres serwera testowego (IP lub hostname)
DEPLOY_HOST=test-server

# Użytkownik SSH
DEPLOY_USER=user

# Port SSH (domyślnie 22)
DEPLOY_PORT=22

# Ścieżka docelowa na serwerze
DEPLOY_PATH=/var/www/html/Czechy_wgranie_faktur

# (Opcjonalnie) Klucz prywatny SSH, np. ~/.ssh/id_rsa
# DEPLOY_SSH_KEY=~/.ssh/id_rsa
